{
  "manifest_version": 3,
  "name": "银杏外部平台获客助手",
  "version": "1.3.1",
  "description": "读取当前作品求助和已展开的公开评论，初筛后送工作台核对。无私信读取、Cookie提取或自动发信。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://qiuchen.yinxingpingpang.com/*",
    "http://127.0.0.1:8796/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "读取当前公开评论需求"
  }
}
