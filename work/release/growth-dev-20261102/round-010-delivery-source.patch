+def public_original_identity(platform, url):
+    """Compare public originals, not platform membership or a guessed redirect.
+
+    Known public note/video routes have stable IDs. For opaque routes preserve
+    query identity; dropping it could confuse distinct Channels posts.
+    """
+    p = urllib.parse.urlsplit(validate_source(platform, url))
+    host, path = (p.hostname or '').lower(), p.path.rstrip('/')
+    if platform == 'douyin' and host in ('douyin.com', 'www.douyin.com'):
+        original = re.fullmatch(r'/(?:video|note)/(\d{10,25})', path)
+        if original:
+            return ('douyin', original[1])
+        # A verified public search overlay exposes its selected work in modal_id.
+        # This was observed in the normal UI; a plain search URL is not evidence.
+        modal = urllib.parse.parse_qs(p.query).get('modal_id', [])
+        if path.startswith('/search/') and len(modal) == 1 and re.fullmatch(r'\d{10,25}', modal[0]):
+            return ('douyin', modal[0])
+    if platform == 'xiaohongshu' and host in ('xiaohongshu.com', 'www.xiaohongshu.com'):
+        original = re.fullmatch(r'/(?:explore|discovery/item)/([a-f0-9]{24})', path)
+        if original:
+            return ('xiaohongshu', original[1])
+    if platform == 'kuaishou' and host == 'www.kuaishou.com':
+        original = re.fullmatch(r'/short-video/([a-zA-Z0-9]{10,30})', path)
+        if original:
+            return ('kuaishou', original[1])
+    if not path or re.match(r'^/(?:search|search_result|profile|user)(?:/|$)', path):
+        raise ValueError('发送凭据须为具体原帖，不能使用主页、个人页或搜索列表')
+    return (host, path, tuple(sorted(urllib.parse.parse_qsl(p.query, keep_blank_values=True))))
+
+
+def validate_delivery_evidence(lead, url):
+    evidence = validate_source(lead['platform'], url)
+    if lead['relation'] == 'public_request' and public_original_identity(lead['platform'], evidence) != public_original_identity(lead['platform'], lead['source_url']):
+        raise ValueError('发送凭据与这条需求的原帖不一致，请核对同一作品的公开链接')
+    return evidence
 
 
